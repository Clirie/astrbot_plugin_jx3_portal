@dataclass(frozen=True)
class CommandSpec:
    key: str
    name: str
    aliases: tuple[str, ...]
    usage: str
    description: str
    category: str
    admin_only: bool = False
    cooldown: int = 3
    requires: tuple[str, ...] = ()

    @property
    def paid(self) -> bool:
        return self.key in PAID_COMMAND_KEYS


PAID_COMMAND_KEYS = frozenset(
    {
        "gold",
        "sand",
        "role",
        "events",
        "strategy",
        "trade",
        "trade_select",
        "achievement",
        "builds",
        "macro",
        "auction",
        "online",
        "image",
        "image_edit",
        "card_ai",
    }
)


