:root{--bg:#ffffff;--bg-soft:#f4f4f5;--panel:#fff;--panel-2:#fafafa;--panel-3:#f4f4f5;--line:#d4d4d8;--line-soft:#e4e4e7;--text:#18181b;--muted:#52525b;--dim:#71717a;--accent:#18181b;--accent-2:#18181b;--accent-3:#18181b;--ok:#276749;--warn:#906018;--bad:#b42318;--radius:10px;--radius-sm:6px;--shadow:0 1px 3px #00000009;--font:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;--mono:ui-monospace,SFMono-Regular,Consolas,monospace}
*{box-sizing:border-box}[hidden]{display:none!important}html,body{margin:0;min-height:100%}body{font:14px/1.55 var(--font);color:var(--text);background:var(--bg);-webkit-font-smoothing:antialiased}button,input,select,textarea{font:inherit;color:inherit}button{cursor:pointer}a{color:var(--accent);text-underline-offset:3px}code,pre{font-family:var(--mono)}::selection{background:#dbeafe}:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button:disabled{opacity:.5;cursor:not-allowed}input[type=checkbox]{accent-color:var(--text)}
.app-shell{display:flex;min-height:100vh}.sidebar{position:sticky;top:0;display:flex;flex-direction:column;width:212px;flex:0 0 212px;height:100vh;padding:28px 14px 20px;background:#fafafa;border-right:1px solid var(--line-soft)}.brand{display:flex;gap:10px;align-items:center;padding:0 8px 34px}.brand-mark{display:grid;place-items:center;width:34px;height:38px;flex:0 0 34px;border-radius:5px;background:var(--accent);color:white;font-family:"Songti SC",serif;font-size:23px}.brand-title{font-size:15px;font-weight:650}.brand-sub,.page-kicker,.eyebrow{display:none}.nav{display:flex;flex-direction:column;gap:5px}.nav-item{display:flex;align-items:center;gap:11px;width:100%;border:1px solid transparent;border-radius:6px;padding:10px 12px;text-align:left;background:transparent;color:var(--muted);font-size:14px}.nav-item:hover{background:#f4f4f5;color:var(--text)}.nav-item.is-active{background:white;border-color:var(--line-soft);color:var(--text);font-weight:650;box-shadow:var(--shadow)}.nav-icon{width:18px;height:18px;display:grid;place-items:center;flex-shrink:0}.nav-icon svg{width:18px;height:18px}.sidebar-foot{margin-top:auto;padding:18px 10px 0;border-top:1px solid var(--line)}.side-status{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:13px}.side-version{font-size:12px;color:var(--dim);margin-top:5px}.dot,.chip-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--ok);flex-shrink:0}.is-bad .dot{background:var(--bad)}
.main{flex:1;min-width:0;padding:32px clamp(20px,3vw,48px) 56px}.topbar{display:flex;justify-content:space-between;align-items:center;gap:20px;max-width:1320px;margin:0 auto 28px}.page-head h1{margin:0 0 4px;font-size:27px;letter-spacing:-.035em;font-weight:650}.page-head p{margin:0;font-size:14px;color:var(--muted)}.topbar-actions{display:flex;align-items:center;gap:14px}.conn-pill{display:flex;align-items:center;gap:7px;font-size:13px;color:var(--muted)}.page{max-width:1320px;margin:0 auto}.card{padding:24px;border:1px solid var(--line-soft);border-radius:var(--radius);background:var(--panel);box-shadow:var(--shadow)}.card+.card,.section-card+.section-card{margin-top:24px}.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:22px}.card-head h3{font-size:17px;font-weight:650;margin:0}.card-head p{font-size:13px;color:var(--muted);margin:5px 0 0;max-width:65ch}.head-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.grid{display:grid;gap:24px;margin-bottom:24px}.grid.two{grid-template-columns:1fr 1fr}.grid>.card{margin:0}.hero-card{display:flex;gap:24px;justify-content:space-between;align-items:center;padding:24px;margin-bottom:24px;background:white;border:1px solid var(--line-soft);border-radius:var(--radius)}.hero-main h2{font-size:18px;font-weight:650;margin:0 0 4px}.hero-main p{margin:0;color:var(--muted);font-size:14px}.hero-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.hero-side{display:grid;grid-template-columns:1fr;gap:8px;min-width:240px;padding-left:26px;border-left:1px solid var(--line-soft)}.hero-chip{display:flex;gap:9px;align-items:center;font-size:13px}.hero-chip.is-warn .chip-dot{background:var(--warn)}.hero-note{font-size:12px;color:var(--dim);margin-top:3px}
.stat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;border:1px solid var(--line-soft);border-radius:var(--radius);background:white;margin:0 0 24px;overflow:hidden}.stat-card{padding:24px;border-right:1px solid var(--line-soft);min-width:0}.stat-card:last-child{border:0}.stat-label{font-size:13px;color:var(--muted)}.stat-value{font-size:32px;font-weight:600;letter-spacing:-.035em;font-variant-numeric:tabular-nums;margin:7px 0 2px;line-height:1.3}.stat-sub{font-size:12px;color:var(--muted)}.stat-grid.compact .stat-card{padding:17px 20px}.stat-grid.compact .stat-value{font-size:26px}.token-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line-soft);padding-top:20px}.token-cell{padding:0 24px;border-left:1px solid var(--line-soft)}.token-cell:first-child{padding-left:0;border:0}.token-cell span{font-size:13px;color:var(--muted);display:block}.token-cell strong{display:block;font-size:25px;font-weight:600;font-variant-numeric:tabular-nums;margin-top:8px}.token-foot{font-size:12px;color:var(--dim);margin-top:20px}.is-ok,#tokenValid.is-ok{color:var(--ok)}.is-bad,#tokenValid.is-bad{color:var(--bad)}.is-warn,.warn-text{color:var(--warn)}.inline-check{display:flex;gap:7px;align-items:center;font-size:13px;color:var(--muted)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:7px 13px;border:1px solid var(--line);border-radius:6px;background:white;font-weight:550;font-size:13px;white-space:nowrap;transition:background .12s,border-color .12s}.btn:hover{background:var(--panel-3);border-color:#a1a1aa}.btn.primary{color:white;background:#18181b;border-color:#18181b}.btn.primary:hover{background:#27272a}.btn.ghost{box-shadow:none;background:transparent}.btn.tiny{min-height:30px;padding:4px 10px;font-size:12px}.btn.danger{color:var(--bad);border-color:#e6c3bf}.btn.danger:hover{background:#fff0ee}.btn.danger-solid{background:var(--bad);border-color:var(--bad);color:white}.btn.is-loading{cursor:wait}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px 26px}.field{display:flex;flex-direction:column;gap:7px;min-width:0}.field.span-2{grid-column:1/-1}.field.grow{flex:1}.field-label{display:flex;align-items:center;justify-content:space-between;gap:12px;font-weight:550;font-size:14px}.field-label a{font-weight:400;font-size:13px}.field-hint{font-size:12px;color:var(--muted);line-height:1.6}input:not([type=checkbox]):not([type=radio]),select,textarea{width:100%;min-width:0;border:1px solid var(--line);border-radius:6px;background:white;padding:9px 11px;outline-offset:2px;box-shadow:0 1px 2px #00000005}textarea{min-height:94px;resize:vertical}input::placeholder,textarea::placeholder{color:#71717a}.secret-row{display:flex;gap:8px}.secret-row input{flex:1}.inline-pill{font-size:12px;color:var(--muted)}.inline-pill.is-ok{color:var(--ok)}.check-line{display:flex;gap:10px;align-items:center;padding:14px 0}.fixed-box{padding:18px;background:var(--panel-2);border:1px solid var(--line-soft);border-radius:6px}.fixed-title{font-weight:600;margin-bottom:12px}.fixed-address{display:flex;gap:10px;justify-content:space-between;flex-wrap:wrap;padding:5px 0}.fixed-address span{color:var(--muted)}.fixed-address code{font-size:12px;overflow-wrap:anywhere}.event-status-line{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px}.event-action-grid{display:grid;gap:18px;grid-template-columns:1fr 1fr}.event-action-group{border-top:1px solid var(--line-soft);padding-top:14px}.event-action-group h4{font-size:14px;margin:0 0 12px}.event-action-list{display:flex;flex-wrap:wrap;gap:8px 18px}.event-check{display:flex;align-items:center;gap:6px;font-size:13px}.event-check code{font-size:11px;color:var(--dim)}.event-table td{vertical-align:top}.event-table td:nth-child(2) code{font-size:12px;overflow-wrap:anywhere}.event-group-row td{background:var(--panel-2);font-weight:600}.guide{margin-top:18px;border-top:1px solid var(--line-soft);padding-top:16px}.guide summary{cursor:pointer;font-weight:550}.guide-body{color:var(--muted);font-size:13px;line-height:1.8;padding-top:12px}.guide-body ol{padding-left:22px}.guide-body li+li{margin-top:7px}.savebar{position:sticky;bottom:16px;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:13px 18px;margin-top:24px;border:1px solid var(--line);border-radius:8px;background:#fffffff5;box-shadow:0 6px 20px #0000000c;z-index:5}.savebar.inline{position:static;box-shadow:none}.savebar-text{font-size:13px;color:var(--muted)}.savebar-text.is-dirty{color:var(--warn)}.savebar-text.is-ok{color:var(--ok)}.savebar-actions{display:flex;gap:8px}
.health-list,.activity-list{display:flex;flex-direction:column}.health-row{display:flex;gap:12px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line-soft)}.health-row:first-child{padding-top:0}.health-row:last-child{padding-bottom:0;border:0}.health-icon{display:grid;place-items:center;width:32px;height:32px;flex:0 0 32px;background:var(--bg-soft);border-radius:6px;color:var(--muted);font-size:13px}.health-body{flex:1;min-width:0}.health-name{font-weight:550;font-size:14px}.health-detail{font-size:12px;color:var(--muted);margin-top:3px;overflow-wrap:anywhere}.health-state{font-size:12px;white-space:nowrap;color:var(--dim)}.health-state.is-ok{color:var(--ok)}.health-state.is-bad{color:var(--bad)}.health-state.is-warn{color:var(--warn)}.activity-row{display:flex;align-items:baseline;gap:10px;padding:11px 0;border-bottom:1px solid var(--line-soft)}.activity-row:last-child{border:0}.activity-time{font-size:12px;color:var(--dim);white-space:nowrap;font-variant-numeric:tabular-nums}.activity-text{font-size:13px;overflow-wrap:anywhere}.dot-mark{display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--muted);flex-shrink:0}.dot-mark.ok{background:var(--ok)}.dot-mark.warn{background:var(--warn)}.dot-mark.error{background:var(--bad)}.empty{padding:30px 18px;text-align:center;color:var(--muted);font-size:13px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.step{display:flex;gap:12px;align-items:flex-start}.step-index{display:grid;place-items:center;width:28px;height:28px;flex:0 0 28px;border:1px solid var(--line);border-radius:50%;font-size:12px}.step.done .step-index{background:#edf5ef;color:var(--ok);border-color:#c8dfcf}.step-title{font-weight:550;font-size:14px}.step-desc{font-size:13px;color:var(--muted);margin-top:4px}
.toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:20px}.toolbar input[type=search]{flex:1;min-width:200px}.toolbar select{width:auto;min-width:120px}.toolbar-count{font-size:13px;color:var(--muted);white-space:nowrap}.table-wrap{overflow:auto;border:1px solid var(--line-soft);border-radius:7px;background:white}.data-table{width:100%;border-collapse:collapse;font-size:14px}.data-table th{text-align:left;position:sticky;top:0;z-index:1;padding:12px 14px;background:var(--panel-2);color:var(--muted);font-size:13px;font-weight:550;border-bottom:1px solid var(--line);white-space:nowrap}.data-table td{padding:14px;border-bottom:1px solid var(--line-soft);vertical-align:middle}.data-table tbody tr:last-child td{border:0}.data-table tbody tr:hover td{background:#fafafa}.data-table .primary-cell,.command-name{font-weight:600;color:var(--text)}.command-aliases{font-size:12px;color:var(--muted);margin-top:5px;max-width:28ch;line-height:1.6}.command-scroll{max-height:clamp(320px,calc(100vh - 385px),720px)}.command-table td:nth-child(3) .primary-cell{font-weight:400}.command-table td:nth-child(2){min-width:160px}.pill-list{display:flex;gap:5px;flex-wrap:wrap}.tag,.mini-tag,.source-pill,.level-badge{display:inline-flex;align-items:center;padding:2px 6px;font-size:11px;border-radius:4px;background:var(--bg-soft);color:var(--muted);white-space:nowrap}.tag.violet,.mini-tag.lv2,.mini-tag.ticket{color:#52525b;background:#f4f4f5}.tag.cyan,.mini-tag.lv1{color:#375b76;background:#ecf1f5}.tag.green,.mini-tag.lv0,.level-badge.info{color:var(--ok);background:#edf5ef}.level-badge.warn{color:var(--warn);background:#faf2e2}.level-badge.error{color:var(--bad);background:#fcf0ee}.permission-select{min-width:104px!important;padding:6px 8px!important;font-size:13px}.cooldown-input{width:70px!important;padding:6px 8px!important;font-variant-numeric:tabular-nums}.switch{display:inline-flex;align-items:center;position:relative;cursor:pointer}.switch input{position:absolute;opacity:0;width:1px;height:1px}.switch span{display:block;width:34px;height:20px;border-radius:20px;background:#d4d4d8;transition:background .15s}.switch span::after{content:"";position:absolute;left:3px;top:3px;width:14px;height:14px;border-radius:50%;background:white;box-shadow:0 1px 3px #0002;transition:transform .15s}.switch input:checked+span{background:#18181b}.switch input:checked+span::after{transform:translateX(14px)}.switch input:focus-visible+span{outline:2px solid var(--accent);outline-offset:3px}.log-table td:nth-child(1){white-space:nowrap;font-size:12px;font-variant-numeric:tabular-nums}.log-table td:nth-child(4),.log-table td:nth-child(5){overflow-wrap:anywhere;max-width:40ch;font-size:13px}
.debug-layout{display:grid;grid-template-columns:300px minmax(0,1fr);gap:24px}.debug-side{min-width:0}.endpoint-list{max-height:600px;overflow-y:auto;margin-top:16px;display:flex;flex-direction:column;gap:5px}.endpoint-item{display:flex;align-items:flex-start;gap:8px;text-align:left;border:1px solid transparent;background:transparent;border-radius:6px;padding:12px;width:100%}.endpoint-item:hover{background:var(--bg-soft)}.endpoint-item.is-active{background:#f4f4f5;border-color:#d4d4d8}.endpoint-item-body{min-width:0;flex:1}.endpoint-item-title{font-size:14px;font-weight:550}.endpoint-item-path{font-size:11px;color:var(--muted);font-family:var(--mono);overflow-wrap:anywhere;margin-top:5px}.endpoint-item-tags{display:flex;gap:4px;margin-top:6px}.debug-form{display:flex;gap:12px;flex-wrap:wrap;align-items:end}.debug-form .field{flex:1;min-width:150px}.debug-form select{min-width:140px}.endpoint-meta{padding:16px 0;color:var(--muted);font-size:13px}.param-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.response-head{display:flex;justify-content:space-between;gap:12px;margin:24px 0 12px}.response-head span{font-size:12px;color:var(--muted)}.code-block{padding:18px;background:#f4f4f5;border:1px solid var(--line-soft);border-radius:6px;font-size:12px;line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere;max-height:600px;overflow:auto;margin:0}
.info-list{display:grid;grid-template-columns:130px minmax(0,1fr);margin:0;font-size:13px}.info-list dt,.info-list dd{margin:0;padding:11px 0;border-bottom:1px solid var(--line-soft);overflow-wrap:anywhere}.info-list dt{color:var(--muted)}.info-list dt:last-of-type,.info-list dd:last-of-type{border:0}.asset-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.asset-grid figure{margin:0}.asset-grid img{width:100%;object-fit:contain}.asset-grid figcaption{font-size:12px;color:var(--muted)}.notice-card{padding:20px 24px;margin-top:24px;border-top:1px solid var(--line)}.notice-card h3{font-size:14px;margin:0 0 6px}.notice-card p{font-size:13px;color:var(--muted);margin:0}.timing-heading{margin:26px 0 12px}.timing-heading h4{font-size:15px;margin:0}.timing-heading p{font-size:12px;margin:5px 0 0;color:var(--muted)}.timing-table tbody th{position:static;background:white;font-size:13px;color:var(--text);border-color:var(--line-soft)}.timing-table td,.timing-table thead th:not(:first-child){text-align:right;font-variant-numeric:tabular-nums}.timing-table .empty-state{text-align:center;padding:28px 12px;color:var(--muted)}
.toast-stack{position:fixed;bottom:24px;right:24px;z-index:100;display:flex;flex-direction:column;gap:10px;max-width:400px}.toast{display:flex;gap:10px;padding:14px 18px;background:white;border:1px solid var(--line);border-radius:8px;box-shadow:0 6px 24px #0002;font-size:14px}.toast-icon{font-weight:700}.toast.ok .toast-icon{color:var(--ok)}.toast.bad .toast-icon{color:var(--bad)}.modal{position:fixed;inset:0;background:#0006;z-index:90;display:grid;place-items:center;padding:20px}.modal-card{width:min(440px,100%);background:white;border-radius:12px;border:1px solid var(--line-soft);padding:26px;box-shadow:0 12px 50px #0003}.modal-card h3{font-size:20px;margin:0 0 12px}.modal-card p{font-size:14px;color:var(--muted);white-space:pre-line}.modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:24px}.loading-panel{display:flex;justify-content:center;align-items:center;gap:16px;min-height:350px;color:var(--muted)}.loading-panel strong{font-weight:500}.loading-panel span{display:block;font-size:13px}.spinner{width:22px;height:22px;border:2px solid var(--line);border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.fatal-panel{padding:48px;text-align:center;max-width:600px;margin:50px auto}.fatal-icon{font-size:28px;color:var(--bad)}.fatal-panel h2{font-size:22px}.fatal-panel p{color:var(--muted)}
@media(max-width:1100px){.sidebar{width:192px;flex-basis:192px;padding:24px 10px}.main{padding:28px 24px 40px}.grid.two{grid-template-columns:1fr}.hero-side{min-width:210px}.stat-card{padding:20px 16px}.stat-value{font-size:28px}.debug-layout{grid-template-columns:240px minmax(0,1fr)}}
@media(max-width:760px){.app-shell{display:block}.sidebar{position:static;width:100%;height:auto;padding:18px 16px 12px;border-right:0;border-bottom:1px solid var(--line)}.brand{padding:0 0 16px}.nav{flex-direction:row;overflow-x:auto;padding-bottom:4px;gap:6px}.nav-item{flex:0 0 auto;width:auto;padding:8px 10px;font-size:13px}.nav-icon{display:none}.sidebar-foot{display:none}.main{padding:22px 16px 40px}.topbar{align-items:start;gap:12px;margin-bottom:22px}.page-head h1{font-size:24px}.page-head p{font-size:13px}.conn-pill{display:none}.topbar-actions{gap:0}.stat-grid{grid-template-columns:1fr 1fr}.stat-card{padding:18px;border-bottom:1px solid var(--line-soft)}.stat-card:nth-child(2){border-right:0}.stat-card:nth-child(3),.stat-card:nth-child(4){border-bottom:0}.hero-card{display:block;padding:20px}.hero-side{padding:18px 0 0;margin-top:20px;border-left:0;border-top:1px solid var(--line-soft);grid-template-columns:1fr}.hero-main h2{font-size:17px}.card{padding:20px}.card-head{flex-wrap:wrap;gap:12px}.form-grid,.event-action-grid,.param-grid{grid-template-columns:1fr}.field.span-2{grid-column:auto}.token-grid{grid-template-columns:1fr 1fr;gap:22px}.token-cell{padding:0 14px}.token-cell:nth-child(3){padding-left:0;border:0}.token-cell strong{font-size:22px}.steps{grid-template-columns:1fr}.savebar{bottom:8px;padding:12px;flex-wrap:wrap}.savebar-actions{margin-left:auto}.toolbar{align-items:stretch}.toolbar input[type=search]{flex-basis:100%}.toolbar select{flex:1}.debug-layout{grid-template-columns:1fr}.endpoint-list{max-height:240px}.info-list{grid-template-columns:100px minmax(0,1fr)}.data-table{font-size:13px}.data-table td,.data-table th{padding:10px}.toast-stack{right:16px;left:16px;bottom:16px;max-width:none}.timing-table{min-width:310px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

/* Console layout: neutral chrome, compact controls, data before decoration. */
.brand-mark{width:32px;height:32px;flex-basis:32px;border-radius:7px;background:#18181b;font-family:var(--font)}.brand-mark svg{width:21px;height:21px}.brand{padding-bottom:20px}.nav{gap:3px}.nav-group-label{font-size:12px;color:#71717a;padding:18px 12px 6px}.nav-item{padding:8px 12px;font-weight:500}.nav-item.is-active{background:#eaeaec;border-color:transparent;box-shadow:none}.sidebar{padding-top:24px}.main{padding-top:28px}.page-head h1{font-size:25px;letter-spacing:-.02em}.topbar{margin-bottom:22px}.overview-actions{display:flex;gap:8px;justify-content:flex-end;margin:0 0 18px}.overview-grid{grid-template-columns:minmax(0,1.35fr) minmax(330px,1fr)}.overview-grid .card{min-height:340px}.overview-grid .activity-list{min-height:236px}.overview-grid .activity-list .empty{margin:auto}.overview-grid .card-head{margin-bottom:16px}.card{box-shadow:none;border-radius:8px}.stat-grid{border-radius:8px}.stat-card{padding:20px 24px}.stat-value{font-size:30px}.card-head h3{font-size:16px}.token-cell strong{font-size:23px}.token-status-card .card-head{margin-bottom:16px}.token-grid{padding-top:16px}.token-foot{margin-top:16px}.activity-row{display:grid;grid-template-columns:5px 62px minmax(0,1fr) auto;gap:10px;align-items:center}.activity-text{line-height:1.5}.health-icon{background:transparent;color:#71717a;width:24px;flex-basis:24px}.health-row{gap:10px}.btn.primary{font-weight:550}.command-table .command-name{font-size:15px}.command-table td{padding:12px 14px}.command-scroll{max-height:clamp(320px,calc(100vh - 370px),720px)}
@media(max-width:1100px){.overview-grid{grid-template-columns:1fr}.overview-grid .card{min-height:0}.overview-grid .activity-list{min-height:170px}}
@media(max-width:760px){.nav-group-label{display:none}.overview-actions{justify-content:flex-start;flex-wrap:wrap}.sidebar{padding-top:16px}.brand{padding-bottom:16px}.page-head h1{font-size:24px}.overview-grid .activity-list{min-height:120px}.activity-row{grid-template-columns:5px 62px minmax(0,1fr)}.activity-row>.tag{grid-column:3;width:max-content}.stat-card{padding:18px}.card{padding:18px}.command-scroll{max-height:55vh}}
